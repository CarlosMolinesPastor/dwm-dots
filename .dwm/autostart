#!/bin/sh

# ============================================================
#  AUTOSTART DE DWM
#  Se ejecuta al iniciar la sesión de Xorg con dwm
# ============================================================

# Fondo de pantalla
xwallpaper --zoom ~/.wallpapers/4.png &

# Recursos X (colores, cursores, etc.)
xrdb merge ~/.Xresources &

# Distribución de teclado latinoamericana
setxkbmap latam &

# Desactivar salvapantallas y DPMS
xset -dpms s off &

# Notificaciones (dunst)
dunst -config ~/.config/dunst/dunstrc-dark-left &

# Portapapeles (xclip)
xclip &

# Compositor (picom) para transparencias y sombras
picom &

# Restaurar tema de colores generado por pywal
wal -r &

# ------------------------------------------------------------
#  Barra de estado personalizada + dwm
#  (NO eliminar estas líneas)
# ------------------------------------------------------------
~/.dwm/bar/./bar.sh &
dwm &

# Applet de NetworkManager (para notificaciones de red)
nm-applet &

# Script de bienvenida (se ejecuta 3 segundos después de arrancar)
sleep 3 && ~/.local/bin/hello.sh
